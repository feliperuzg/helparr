# Node / Next.js
node_modules/
.next/
next-env.d.ts
tsconfig.tsbuildinfo

# The assembled landing site. `site/` is the source and is committed; this is
# what `npm run site` copies it into, alongside the screenshots and the mark.
.site/

# The operator's database and its WAL sidecars. Encrypted at rest, and still
# never something to commit.
*.db
*.db-shm
*.db-wal

# Local environment — never commit the encryption key or operator password
.env
.env.local
.env*.local
